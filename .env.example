# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth (session JWT maison — obligatoire en production)
AUTH_SECRET=generate-a-long-random-secret

# Setup initial (optionnel)
SETUP_TOKEN=one-time-setup-token

# Web Push (optionnel)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@example.com

# Email (SMTP) — envoi des emails transactionnels
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSW=
SMTP_FROM="Nom <contact@example.com>"
# URL publique de l'application (liens dans les emails)
APP_URL=http://localhost:3000
# Secret des tâches planifiées (/api/cron/*)
CRON_SECRET=
